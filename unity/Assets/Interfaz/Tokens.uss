/*
 * Tokens de la interfaz: la única hoja de color, tipografía y espacio (spec, "La interfaz").
 * Tema claro en :root; el oscuro en .tema-oscuro, que redefine solo los colores.
 * Cada par de colores lo mide scripts/guard-contraste.mjs (WCAG 2.2 AA). Criterios y fuentes
 * de cada decisión: docs/BLUEPRINT.md, Fase 6, decisiones D20 en adelante.
 * Unidades: 1 px de USS es 1 dp en Android y 1 píxel efectivo en Windows (Aplicacion.cs).
 */

:root {
    /* Superficies: grises neutros, espejo claro del esquema osk-win "Windows" (2026-11-02). El color se reserva para los estados (D21). */
    --color-fondo: #F3F3F3;
    --color-superficie: #F3F3F3;
    --color-superficie-2: #E5E5E5;
    --color-borde: #E5E5E5;            /* separador decorativo, no delimita un control */
    --color-borde-control: #767676;
    --color-texto: #191919;
    --color-texto-2: #5C5C5C;
    --color-primario: #191919;          /* tinta: el paso siguiente, sin un tono que compita con los estados */
    --color-sobre-primario: #FFFFFF;
    --color-foco: #3A79E0;          /* entre el fondo claro y la tinta: 3:1 con los dos */

    /* Estados del panel: siempre con su forma y su palabra (WCAG 1.4.1). */
    --color-estado-por-pegar: #6B665D;
    --color-estado-falta-enviar: #8A5300;
    --color-estado-respondiendo: #1F5BB8;
    --color-estado-terminado: #00695F;
    --color-estado-capturado: #2C6E31;
    --color-estado-problema: #B3261E;

    /* Tipografía: una sola familia (Atkinson Hyperlegible Next), escala 1,2 (D23). */
    --texto-pequeno: 14px;
    --texto-cuerpo: 16px;
    --texto-titulo: 20px;
    --texto-encabezado: 24px;
    --texto-lectura: 18px;             /* textos largos (ayuda): 18 o más, Rello y otros 2016 */
    --medida-parrafo: 620px;           /* unos 70 caracteres a 16 px: el largo que se prefiere (Dyson 2004) */

    /* Espacio en pasos de 4 y objetivos de 48 (D19). */
    --esp-1: 4px;
    --esp-2: 8px;
    --esp-3: 12px;
    --esp-4: 16px;
    --esp-5: 24px;
    --esp-6: 32px;
    --color-velo: rgba(0, 0, 0, 0.5);    /* detrás del cajón modal (D3); no lleva texto encima */
    --alto-control: 48px;
    --radio: 6px;
    --ancho-foco: 2px;
}

/* Esquema osk-win "Windows" (teclado en pantalla de Windows 10, oscuro): fondo #1A1A1A, tecla #333333, texto blanco
   y #E5E5E5 con #191919 para lo activo. El borde de control y el foco no son del esquema: WCAG 1.4.11 pide 3:1. */
.tema-oscuro {
    --color-fondo: #1A1A1A;
    --color-superficie: #1A1A1A;
    --color-superficie-2: #333333;
    --color-borde: #333333;
    --color-borde-control: #8F8F8F;
    --color-texto: #FFFFFF;
    --color-texto-2: #A3A3A3;          /* blanco al 60 % sobre el fondo, como las pistas del teclado */
    --color-primario: #E5E5E5;
    --color-sobre-primario: #191919;
    --color-foco: #808080;             /* gris entre la tecla y el acento: 3:1 con los dos */

    --color-estado-por-pegar: #A49E94;
    --color-estado-falta-enviar: #E8A33D;
    --color-estado-respondiendo: #86B0F5;
    --color-estado-terminado: #4FC2B4;
    --color-estado-capturado: #82C785;
    --color-estado-problema: #F28B82;
}
